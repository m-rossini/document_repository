# Copy to docker-compose.env (make init does this automatically) and edit.
# docker-compose.env is gitignored — never commit real secrets.

# Names the Compose project; containers become documentrepo-<service>-1
COMPOSE_PROJECT_NAME=documentrepo

# Host port for the web UI (http://localhost:<PAPERLESS_PORT>)
PAPERLESS_PORT=8000

# Timezone (IANA name). Kept UTC for consistency.
TZ=UTC

# PostgreSQL credentials
POSTGRES_DB=paperless
POSTGRES_USER=paperless
POSTGRES_PASSWORD=change-me-db-password

# Django secret key — REQUIRED, must be unique and secret.
# Generate one with:  openssl rand -base64 48
PAPERLESS_SECRET_KEY=change-me-generate-a-real-secret
