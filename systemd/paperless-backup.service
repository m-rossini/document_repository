[Unit]
Description=Paperless-ngx Rclone Backup Service
After=network-online.target

[Service]
Type=oneshot
# %h automatically expands to the home directory of the user running the timer
WorkingDirectory=%h/my-archive-repo
ExecStart=/bin/bash %h/my-archive-repo/backup.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target